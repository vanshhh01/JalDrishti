{
  "name": "jaldrishti-backend",
  "version": "1.0.0",
  "description": "JalDrishti Smart Water Intelligence System Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "node src/scripts/db_sync.js",
    "start": "node src/scripts/db_sync.js && node src/server.js",
